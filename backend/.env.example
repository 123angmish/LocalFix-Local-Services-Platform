# LocalFix Backend Environment Variables Configuration

# Server
PORT=8080

# Database Configuration (Defaults to H2 in-memory when empty)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/localfixdb
SPRING_DATASOURCE_DRIVER=org.postgresql.Driver
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.PostgreSQLDialect
FLYWAY_ENABLED=true

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379

# Security & JWT
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional External AI API Key (Gemini or OpenAI)
AI_API_KEY=

# Optional Payment Gateway Integration (Defaults to 'dummy')
PAYMENT_PROVIDER=dummy
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Mail Server Configuration
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
