# ==========================================
# LOCALFIX STARTUP MVP ENVIRONMENT CONFIG
# ==========================================

# Server Port
PORT=8080

# Database Configuration (PostgreSQL / H2)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/localfixdb
SPRING_DATASOURCE_DRIVER=org.postgresql.Driver
SPRING_DATASOURCE_USERNAME=localfix_user
SPRING_DATASOURCE_PASSWORD=localfix_secret_password
SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.PostgreSQLDialect

# Flyway Migrations
FLYWAY_ENABLED=true

# Redis Cache Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Security
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# AI Multimodal LLM Integration
# Set your Gemini/OpenAI API key below to enable real AI issue diagnosis & price estimation.
# If left blank, the application explicitly shows "AI service unavailable".
AI_API_KEY=

# File Storage Configuration (Uploads)
UPLOAD_DIR=uploads

# Payment Provider Configuration (dummy or razorpay)
PAYMENT_PROVIDER=dummy
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
